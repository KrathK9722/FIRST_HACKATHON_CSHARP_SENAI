<Window x:Class="Desafio_CRUD.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Desafio_CRUD"
        mc:Ignorable="d"
        Title="StartScreen" Height="450" Width="800">
    <Grid>
        <!-- Definição das duas colunas principais -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="menu_column" Width="61"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- COLUNA 0: Menu Lateral -->
        <StackPanel x:Name="side_menu" Grid.Column="0" Background="#FFC5C5C5">

            <Grid Height="60">
                <Image Source="/house-removebg-preview.png" Stretch="Uniform" Width="24" Height="24"
                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,5,0,0" IsHitTestVisible="False"/>
                <Button x:Name="menu_button_start" Content="Inicio" Width="58" Height="30"
                        VerticalAlignment="Bottom" Background="#FFC5C5C5" BorderBrush="#FFC5C5C5"
                        Click="start_click"/>
            </Grid>

            <Grid Height="80
                  ">
                <Image Source="/perfil-removebg-preview.png" Stretch="Uniform" Width="24" Height="24"
                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,5,0,0" IsHitTestVisible="False"/>
                <Button x:Name="menu_button_register" Content="Registrar &#xD;&#xA;Casas" Width="62" Height="40"
                        VerticalAlignment="Top" Background="#FFC5C5C5" BorderBrush="#FFC5C5C5"
                        Click="register_click" Margin="0,30,0,0" HorizontalAlignment="Center"/>
            </Grid>

            <Grid Height="80
                  ">
                <Image Source="/help-removebg-preview.png" Stretch="Uniform" Width="24" Height="24"
                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,5,0,0" IsHitTestVisible="False"/>
                <Button x:Name="menu_button_edit" Content="Editar &#xD;&#xA;Casas" Width="78" Height="40"
                        VerticalAlignment="Top" Background="#FFC5C5C5" BorderBrush="#FFC5C5C5"
                        Click="edit_click" Margin="0,30,0,0" HorizontalAlignment="Center"/>
            </Grid>
            <Grid Height="80">
                <Image Source="/exit-removebg-preview.png" Stretch="Uniform" Width="24" Height="24"
                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,5,0,0" IsHitTestVisible="False"/>
                <Button x:Name="menu_button_remove" Content="Remover &#xD;&#xA; Casas" Width="78" Height="40"
                        VerticalAlignment="Top" Background="#FFC5C5C5" BorderBrush="#FFC5C5C5"
                        Click="remove_click" Margin="0,30,0,0" HorizontalAlignment="Center"/>
            </Grid>
            <Grid Height="60">
                <Image Source="/exit-removebg-preview.png" Stretch="Uniform" Width="24" Height="24"
                  HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,5,0,0" IsHitTestVisible="False"/>
                <Button x:Name="menu_button_exit" Content="Sair" Width="58" Height="30"
            VerticalAlignment="Bottom" Background="#FFC5C5C5" BorderBrush="#FFC5C5C5"
            Click="exit_click"/>
            </Grid>

        </StackPanel>

        <!-- COLUMN 1: WINDOWS -->

        <!-- REGISTER -->
        <Grid x:Name="register_screen" Grid.Column="1" Visibility="Visible">
            <Button x:Name="menu_register" Content="Menu" HorizontalAlignment="Left" Margin="0,10,0,0"
                    VerticalAlignment="Top" Background="#FFC5C5C5" BorderBrush="#FFC5C5C5"
                    Click="menu_button_click" Width="49"/>
            <Label x:Name="title_register" Content="Registrar Casa" HorizontalAlignment="Center" Margin="0,50,0,0"
                   VerticalAlignment="Top" Height="30" FontWeight="Bold" FontSize="14"/>
            <TextBox x:Name="register_location" HorizontalAlignment="Center" Margin="0,106,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" TextChanged="TextBox_TextChanged"/>
            <ComboBox x:Name="register_floor" HorizontalAlignment="Center" VerticalAlignment="Top" Width="120" AlternationCount="5" SelectedIndex="-1" SelectionChanged="ComboBox_SelectionChanged" Margin="0,153,0,0">
                <ComboBoxItem Content="1 andar" />
                <ComboBoxItem Content="2 andares" />
                <ComboBoxItem Content="3 andares" />
                <ComboBoxItem Content="4 andares" />
                <ComboBoxItem Content="5 andares ou mais" />
            </ComboBox>
            <Label Content="Andares" HorizontalAlignment="Center" Margin="0,127,0,0" VerticalAlignment="Top"/>
            <ComboBox x:Name="register_bedroom" HorizontalAlignment="Center" VerticalAlignment="Top" Width="120" AlternationCount="7" SelectedIndex="-1" SelectionChanged="ComboBox_SelectionChanged" Margin="0,201,0,0">
                <ComboBoxItem Content="1" />
                <ComboBoxItem Content="2" />
                <ComboBoxItem Content="3" />
                <ComboBoxItem Content="4" />
                <ComboBoxItem Content="5" />
                <ComboBoxItem Content="6" />
                <ComboBoxItem Content="7 ou mais" />
            </ComboBox>
            <Label Content="Quantos Quartos" Margin="0,173,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" Width="101"/>
            <ComboBox x:Name="register_bathroom" HorizontalAlignment="Center" VerticalAlignment="Top" Width="120" AlternationCount="5" SelectedIndex="-1" SelectionChanged="ComboBox_SelectionChanged" Margin="0,253,0,0">
                <ComboBoxItem Content="1" />
                <ComboBoxItem Content="2" />
                <ComboBoxItem Content="3" />
                <ComboBoxItem Content="4" />
                <ComboBoxItem Content="5 ou mais" />
            </ComboBox>
            <Label Content="Quantos Banheiros" HorizontalAlignment="Center" Margin="0,227,0,0" VerticalAlignment="Top"/>
            <Label Content="Location" HorizontalAlignment="Center" Margin="0,80,0,0" VerticalAlignment="Top" RenderTransformOrigin="1.052,0.618"/>
            <CheckBox x:Name="has_furniture" Content="Com mobília" HorizontalAlignment="Center" Margin="0,368,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.224,0.599" Checked="CheckBox_Checked"/>
            <Slider x:Name="price_slide" HorizontalAlignment="Center" Margin="0,296,0,0" VerticalAlignment="Top" Width="120"
                Minimum="100000"
                Maximum="10000000"   
                Value="3" 
                TickFrequency="10000" 
                TickPlacement="BottomRight" 
                IsSnapToTickEnabled="True" ValueChanged="Slider_PriceChanged"/>
            <Label x:Name="price_register" Content="Price:" HorizontalAlignment="Left" Margin="311,270,0,0" VerticalAlignment="Top"/>
            <Slider x:Name="area_slide" HorizontalAlignment="Center" Margin="0,339,0,0" VerticalAlignment="Top" Width="120"
                Minimum="10"
                Maximum="1000"   
                Value="10" 
                TickFrequency="5" 
                TickPlacement="BottomRight" 
                IsSnapToTickEnabled="True" ValueChanged="Slider_AreaChanged"/>
            <Label x:Name="area_register" Content="Area:" HorizontalAlignment="Left" Margin="311,313,0,0" VerticalAlignment="Top"/>
            <Button x:Name="confirm_click" Content="Criar Registro" HorizontalAlignment="Center" Margin="0,397,0,0" VerticalAlignment="Top" Click="confirm_Click"/>
        </Grid>

        <!-- EDIT -->
        <Grid x:Name="edit_screen" Grid.Column="1" Visibility="Collapsed">
            <Button x:Name="menu_edit" Content="Menu" HorizontalAlignment="Left" Margin="0,10,0,0"
                    VerticalAlignment="Top" Background="#FFC5C5C5" BorderBrush="#FFC5C5C5"
                    Click="menu_button_click" Width="49"/>
            <Label x:Name="title_edit" Content="Edição de Casas" HorizontalAlignment="Center" Margin="0,50,0,0"
                   VerticalAlignment="Top" Height="30" FontWeight="Bold" FontSize="14"/>
        </Grid>

        <!-- LANDING PAGE -->
        <Grid x:Name="landing_page" Grid.Column="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="173*"/>
                <RowDefinition Height="261*"/>
            </Grid.RowDefinitions>
            <DataGrid x:Name="landing_page_data" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="52,121,53,30" Grid.RowSpan="2"/>
            <Button x:Name="menu_button_register_first_house" Content="Registre sua primeira casa" Width="206" Height="40"
                    VerticalAlignment="Top" Background="#FFC5C5C5" BorderBrush="#FFC5C5C5"
                    Click="register_click" Margin="0,90,0,0" HorizontalAlignment="Center" Grid.Row="1"/>
            <Button x:Name="menu_button_landing_page" Content="Menu" HorizontalAlignment="Left" Margin="0,10,0,0"
                    VerticalAlignment="Top" Background="#FFC5C5C5" BorderBrush="#FFC5C5C5"
                    Click="menu_button_click" Width="49" Height="20"/>
            <Label x:Name="title_landing_page" Content="Bem vindo a Imobiliária Arfe" HorizontalAlignment="Center" Margin="0,50,0,0"
                    VerticalAlignment="Top" Height="30" FontWeight="Bold" FontSize="14"/>
        </Grid>

        <!-- REMOVE -->
        <Grid x:Name="remove_screen" Grid.Column="1" Visibility="Collapsed">
            <Button x:Name="menu_remove" Content="Menu" HorizontalAlignment="Left" Margin="0,10,0,0"
            VerticalAlignment="Top" Background="#FFC5C5C5" BorderBrush="#FFC5C5C5"
            Click="menu_button_click" Width="49"/>
            <Label x:Name="title_remove" Content="Remoção de Casas" HorizontalAlignment="Center" Margin="0,50,0,0"
           VerticalAlignment="Top" Height="30" FontWeight="Bold" FontSize="14"/>
        </Grid>

    </Grid>
</Window>